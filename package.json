{
  "name": "project-echo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @echo/desktop dev",
    "build": "pnpm --filter @echo/desktop build",
    "lint": "pnpm --filter @echo/desktop lint",
    "test": "cargo test --workspace",
    "schema": "pnpm --filter @echo/config-schema generate",
    "prepare": "husky install"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "prettier": "2.8.8"
  }
}
